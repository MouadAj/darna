# API
DATABASE_URL="postgresql://housefamily:housefamily@localhost:55432/housefamily?schema=public"
# Optional direct PostgreSQL URL for migrations; Neon runtime DATABASE_URL is pooled.
DIRECT_URL=""
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
SESSION_COOKIE_NAME="housefamily_session"
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=30
INVITATION_TTL_DAYS=7
# EmailJS is called only by the API. Configure one template with the variables
# to_email, to_name, from_name, subject, message, action_url, and action_label.
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
EMAIL_FROM_NAME="HouseFamily"
# Set to false in production. When EmailJS is unconfigured, development mode
# logs confirmation/invitation links and displays them in the local UI.
DEV_AUTH_ENABLED=true
NODE_ENV=development

# Web. The browser uses a same-origin proxy by default; API_INTERNAL_URL is server-only.
NEXT_PUBLIC_API_URL="/api"
API_INTERNAL_URL="http://localhost:4000"
# Enable only after configuring VAPID keys and a push-delivery worker/provider.
NEXT_PUBLIC_PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
